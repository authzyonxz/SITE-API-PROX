# ─── VARIÁVEIS DE AMBIENTE OBRIGATÓRIAS ──────────────────────────────────────
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env no repositório!

# ─── Segurança JWT ────────────────────────────────────────────────────────────
# OBRIGATÓRIO em produção: Chave secreta para assinar tokens JWT.
# Deve ter pelo menos 32 caracteres. Gere com: openssl rand -hex 32
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_PELO_MENOS_32_CARACTERES

# ─── API Proxy Externa ────────────────────────────────────────────────────────
# OBRIGATÓRIO: URL base da API de proxy externa
PROXY_API_BASE=https://ruan.xarifi.com

# OBRIGATÓRIO: Chave mestre para autenticar na API de proxy externa
# NUNCA exponha esta chave no código-fonte ou no frontend!
PROXY_MASTER_KEY=SUA_MASTER_KEY_AQUI

# ─── Banco de Dados ───────────────────────────────────────────────────────────
# Configurado automaticamente pelo ambiente Manus
# DATABASE_URL=

# ─── Ambiente ────────────────────────────────────────────────────────────────
NODE_ENV=production
